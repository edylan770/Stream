# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/

# Machine-local config: data_root, ffmpeg paths, review port.
# The build machine and the streaming PC must never fight over these.
clipforge/config/local.yaml

# §5.7 asks for "the girlfriend's name and any recurring nicknames" in the
# vocabulary. Names of real people should not need a commit; this file is
# merged into vocabulary.txt automatically when present.
clipforge/config/vocabulary.local.txt

# Data root default. Masters, proxies, WAVs, previews, exports, and the DB.
data/
*.db
*.db-wal
*.db-shm

# Video, anywhere. Test footage does not always land under data/, and nothing
# in this project ever wants a 300 MB blob in git history.
*.mp4
*.mkv
*.mov
*.webm
*.flv

# Claude Code's working directory: launch configs and local settings, which are
# per-machine (ports, scratch database paths) rather than project state.
.claude/
